{
    "name": "portfolio",
    "version": "1.0.0",
    "packageManager": "yarn@4.14.1",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "update:deps": "yarn up '*' 'typescript@~6.0.3'",
        "build:prod": "ng build --configuration production --aot --output-hashing=all",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint": "ng lint"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^22.2.2",
        "@angular/compiler": "^22.2.2",
        "@angular/core": "^22.2.2",
        "@angular/forms": "^22.2.2",
        "@angular/platform-browser": "^22.2.2",
        "@angular/platform-server": "^22.2.2",
        "@angular/router": "^22.2.2",
        "@angular/ssr": "^22.2.2",
        "@tailwindcss/postcss": "^4.3.3",
        "postcss": "^8.5.30",
        "primeicons": "^8.0.2",
        "rxjs": "^7.8.2",
        "tailwindcss": "^4.3.3",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular-eslint/schematics": "^22.6.0",
        "@angular/build": "^22.2.2",
        "@angular/cli": "^22.2.2",
        "@angular/compiler-cli": "^22.2.2",
        "@eslint/js": "^10.0.1",
        "@types/jasmine": "^7.0.0",
        "@types/node": "^26.6.5",
        "angular-eslint": "^22.6.0",
        "eslint": "^10.12.0",
        "jasmine-core": "^7.0.2",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "^2.2.1",
        "karma-jasmine": "^5.1.0",
        "karma-jasmine-html-reporter": "^2.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2"
    }
}
