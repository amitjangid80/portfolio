{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Name kept from the old headers Worker so its CONTACT_DESTINATION_EMAIL secret carries over.
    "name": "portfolio-security-headers",
    "main": "cloudflare/contact-worker.js",
    "compatibility_date": "2026-10-12",
    "assets": {
        "directory": "./dist/portfolio/browser",
        "not_found_handling": "single-page-application",
        // Only the contact endpoint runs Worker code; every asset request is served free.
        "run_worker_first": ["/api/*"]
    },
    "send_email": [{ "name": "EMAIL" }],
    "routes": [{ "pattern": "portfolio.amit-jangid.in", "custom_domain": true }],
    "workers_dev": false,
    "preview_urls": false
}
