server {
    listen ${NGINX_LISTEN_PORT} default_server;
    listen [::]:${NGINX_LISTEN_PORT} default_server;

    server_name _;

    return 444;
}

server {
    listen ${NGINX_LISTEN_PORT};
    listen [::]:${NGINX_LISTEN_PORT};

    server_name ${NGINX_SERVER_NAME};

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    server_tokens off;
    client_max_body_size 10m;

    include /etc/nginx/conf.d/security-headers.conf;

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* \.(?:bak|config|dist|fla|git|hg|inc|ini|log|map|orig|psd|sh|sql|svn|swp|tpl|yml|yaml)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    location = /env.js {
        limit_except GET HEAD {
            deny all;
        }

        expires -1;

        include /etc/nginx/conf.d/security-headers.conf;
    }

    location ~* \.(?:css|js|mjs|woff|woff2|ttf|eot|png|jpg|jpeg|gif|svg|ico|webp|avif)$ {
        limit_except GET HEAD {
            deny all;
        }

        expires 365d;

        include /etc/nginx/conf.d/security-headers.conf;

        access_log off;
        try_files $uri =404;
    }

    location / {
        limit_except GET HEAD {
            deny all;
        }

        expires -1;

        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;

        include /etc/nginx/conf.d/security-headers.conf;

        try_files $uri $uri/ /index.html;
    }

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    error_page 500 502 503 504 /50x.html;

    location = /50x.html {
    }
}
